        <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Expect CHECK Violation"><collectionProp name="Asserion.test_strings"><stringProp name="expected">1185</stringProp></collectionProp><stringProp name="Assertion.custom_message">Expected the call to fail with 1185</stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">2</intProp><stringProp name="TestPlan.comments">The call must fail on the CHECK constraint. JMeter puts the SQLSTATE and the vendor error code in the response code field (here '23514 1185'), so assert on the error number rather than the constraint name, which a reader may rename.</stringProp></ResponseAssertion><hashTree /><ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="View Results Tree" enabled="true">
