          <hashTree /></hashTree></hashTree></hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="INVALID INPUT Thread Group" enabled="false">
        <stringProp name="TestPlan.comments">Deliberately failing calls live here, NOT in the measured groups. Shipped DISABLED because the Response Time Graph sits at test plan level and would otherwise fold these samples into the latency numbers. Enable it on its own to verify rollback, then disable it again before measuring.</stringProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
